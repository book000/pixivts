    "@types/node": "24.13.6",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.6.0"
